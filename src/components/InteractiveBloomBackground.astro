<div class="bloom-background" aria-hidden="true">
  <div class="bloom-scene"></div>
  <div class="bloom-sunlight"></div>
  <canvas id="bloom-dandelion-canvas"></canvas>
  <div class="bloom-wash"></div>
</div>

<style>
  .bloom-background {
    --bloom-x: 0px;
    --bloom-y: 0px;
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  :global(html[data-theme="bloom"]) .bloom-background { opacity: 1; }

  .bloom-scene,
  .bloom-sunlight,
  .bloom-wash,
  #bloom-dandelion-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bloom-scene {
    background-image: url("/images/bloom-flower-field-v2.png");
    background-size: cover;
    background-position: center;
    transform: translate3d(var(--bloom-x), var(--bloom-y), 0) scale(1.12);
    transform-origin: center;
    filter: saturate(1.04) contrast(0.98);
    transition: transform 450ms cubic-bezier(0.2, 0.75, 0.25, 1);
    will-change: transform;
  }

  .bloom-sunlight {
    background:
      radial-gradient(circle at 12% 8%, rgb(255 255 226 / 0.5), transparent 19%),
      linear-gradient(135deg, rgb(255 244 174 / 0.15), transparent 48%);
    mix-blend-mode: screen;
    animation: sunlight-breathe 6s ease-in-out infinite alternate;
  }

  .bloom-wash {
    background:
      linear-gradient(90deg, rgb(255 249 219 / 0.1), transparent 44%, rgb(255 240 196 / 0.06)),
      linear-gradient(0deg, rgb(91 64 25 / 0.1), transparent 38%);
  }

  #bloom-dandelion-canvas { z-index: 1; }

  @keyframes sunlight-breathe {
    from { opacity: 0.72; }
    to { opacity: 1; }
  }

  @media (max-width: 640px) {
    .bloom-scene { background-position: 54% center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bloom-background,
    .bloom-scene { transition: none; }
    .bloom-scene { transform: scale(1.04); }
    .bloom-sunlight { animation: none; }
  }
</style>

<script is:inline>
  function initBloomDandelions() {
    window.__bloomfolioBloomCleanup?.();

    const canvas = document.getElementById("bloom-dandelion-canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const context = canvas.getContext("2d");
    if (!context) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mouse = { x: -1000, y: -1000, active: false, radius: 90 };
    let particles = [];
    let frameId = 0;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let bloomTheme = document.documentElement.dataset.theme === "bloom";

    function makeSeed(randomizePosition = true) {
      const driftX = 0.34 + Math.random() * 0.72;
      const driftY = -0.13 + Math.random() * 0.25;
      return {
        x: randomizePosition ? Math.random() * width : -30 - Math.random() * 100,
        y: Math.random() * height,
        vx: driftX,
        vy: driftY,
        driftX,
        driftY,
        size: 0.55 + Math.random() * 1.1,
        alpha: 0.35 + Math.random() * 0.48,
        phase: Math.random() * Math.PI * 2,
        wobble: 0.004 + Math.random() * 0.008,
        rotation: Math.random() * Math.PI * 2,
        spin: (Math.random() - 0.5) * 0.015,
      };
    }

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
      const desiredCount = reducedMotion.matches
        ? Math.max(56, Math.min(90, Math.round(width / 14)))
        : Math.max(176, Math.min(340, Math.round(width / 4)));
      particles = Array.from({ length: desiredCount }, () => makeSeed(true));
    }

    function respawnSeed(seed) {
      Object.assign(seed, makeSeed(false));
      seed.x = -25 - Math.random() * 110;
      seed.y = Math.random() * height;
    }

    function bounceFromMouse(seed) {
      if (!mouse.active) return;
      let dx = seed.x - mouse.x;
      let dy = seed.y - mouse.y;
      let distance = Math.hypot(dx, dy);
      if (distance >= mouse.radius) return;

      if (distance < 0.01) {
        const angle = Math.random() * Math.PI * 2;
        dx = Math.cos(angle);
        dy = Math.sin(angle);
        distance = 1;
      }

      const nx = dx / distance;
      const ny = dy / distance;
      const inwardVelocity = seed.vx * nx + seed.vy * ny;
      if (inwardVelocity < 0) {
        seed.vx -= 2.05 * inwardVelocity * nx;
        seed.vy -= 2.05 * inwardVelocity * ny;
      }

      const displacement = mouse.radius - distance + 1.2;
      seed.x += nx * displacement;
      seed.y += ny * displacement;
      seed.vx += nx * 0.15;
      seed.vy += ny * 0.15;
      seed.spin += (Math.random() - 0.5) * 0.035;
    }

    function drawSeed(seed) {
      context.save();
      context.translate(seed.x, seed.y);
      context.rotate(seed.rotation);
      context.lineCap = "round";
      context.lineWidth = Math.max(0.42, seed.size * 0.4);
      context.strokeStyle = `rgba(255, 253, 232, ${seed.alpha})`;
      context.fillStyle = `rgba(255, 248, 218, ${Math.min(0.95, seed.alpha + 0.14)})`;

      const stem = 2.6 + seed.size * 2.4;
      context.beginPath();
      context.moveTo(0, seed.size * 0.25);
      context.lineTo(-stem * 0.72, stem);
      context.stroke();

      const crownRadius = 1.3 + seed.size * 1.35;
      for (let index = 0; index < 5; index += 1) {
        const angle = -Math.PI * 0.86 + index * (Math.PI * 0.43);
        context.beginPath();
        context.moveTo(0, 0);
        context.lineTo(Math.cos(angle) * crownRadius, Math.sin(angle) * crownRadius);
        context.stroke();
      }

      context.beginPath();
      context.arc(0, 0, Math.max(0.45, seed.size * 0.46), 0, Math.PI * 2);
      context.fill();
      context.restore();
    }

    function animate(time = 0) {
      frameId = window.requestAnimationFrame(animate);
      context.clearRect(0, 0, width, height);
      if (!bloomTheme) return;

      const motionScale = reducedMotion.matches ? 0.2 : 1;
      for (const seed of particles) {
        const breeze = Math.sin(time * seed.wobble + seed.phase);
        seed.x += (seed.vx + breeze * 0.18) * motionScale;
        seed.y += (seed.vy + breeze * 0.11) * motionScale;
        seed.rotation += seed.spin * motionScale;
        if (!reducedMotion.matches) bounceFromMouse(seed);
        seed.vx += (seed.driftX - seed.vx) * 0.004;
        seed.vy += (seed.driftY - seed.vy) * 0.004;

        if (seed.x > width + 45 || seed.y < -70 || seed.y > height + 70 || seed.x < -180) {
          respawnSeed(seed);
        }
        drawSeed(seed);
      }
    }

    function onPointerMove(event) {
      mouse.x = event.clientX;
      mouse.y = event.clientY;
      mouse.active = true;
      if (!reducedMotion.matches) {
        const normalizedX = event.clientX / Math.max(1, width) - 0.5;
        const normalizedY = event.clientY / Math.max(1, height) - 0.5;
        canvas.parentElement?.style.setProperty("--bloom-x", `${normalizedX * -5.8}vw`);
        canvas.parentElement?.style.setProperty("--bloom-y", `${normalizedY * -4.4}vh`);
      }
    }

    function onPointerLeave() {
      mouse.active = false;
      canvas.parentElement?.style.setProperty("--bloom-x", "0px");
      canvas.parentElement?.style.setProperty("--bloom-y", "0px");
    }

    const themeObserver = new MutationObserver(() => {
      bloomTheme = document.documentElement.dataset.theme === "bloom";
      if (!bloomTheme) context.clearRect(0, 0, width, height);
    });

    resize();
    animate();
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    window.addEventListener("resize", resize);
    window.addEventListener("pointermove", onPointerMove, { passive: true });
    document.documentElement.addEventListener("pointerleave", onPointerLeave);

    window.__bloomfolioBloomCleanup = () => {
      window.cancelAnimationFrame(frameId);
      themeObserver.disconnect();
      window.removeEventListener("resize", resize);
      window.removeEventListener("pointermove", onPointerMove);
      document.documentElement.removeEventListener("pointerleave", onPointerLeave);
      window.__bloomfolioBloomCleanup = null;
    };
  }

  initBloomDandelions();
  document.addEventListener("astro:page-load", initBloomDandelions);
  document.addEventListener("astro:before-swap", () => window.__bloomfolioBloomCleanup?.());
</script>
