<div class="meteor-background" aria-hidden="true">
  <div class="meteor-scene"></div>
  <canvas id="meteor-particle-canvas"></canvas>
  <div class="meteor-vignette"></div>
</div>

<style>
  .meteor-background {
    --scene-x: 0px;
    --scene-y: 0px;
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  :global(html[data-theme="dark"]) .meteor-background {
    opacity: 1;
  }

  .meteor-scene,
  .meteor-vignette,
  #meteor-particle-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .meteor-scene {
    background-image: url("/images/dark-meteor-night.png");
    background-size: cover;
    background-position: center;
    transform: translate3d(var(--scene-x), var(--scene-y), 0) scale(1.12);
    transform-origin: center;
    filter: saturate(1.08) contrast(1.04);
    transition: transform 420ms cubic-bezier(0.2, 0.75, 0.25, 1);
    will-change: transform;
  }

  .meteor-vignette {
    background:
      radial-gradient(circle at 72% 38%, transparent 0 18%, rgb(2 5 18 / 0.18) 58%, rgb(1 3 12 / 0.58) 100%),
      linear-gradient(90deg, rgb(2 6 22 / 0.42), transparent 48%, rgb(4 5 19 / 0.08));
  }

  #meteor-particle-canvas {
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .meteor-background {
      transition: none;
    }

    .meteor-scene {
      transform: scale(1.04);
      transition: none;
    }
  }
</style>

<script is:inline>
  function initMeteorParticles() {
    if (window.__bloomfolioMeteorCleanup) {
      window.__bloomfolioMeteorCleanup();
    }

    const canvas = document.getElementById("meteor-particle-canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const context = canvas.getContext("2d");
    if (!context) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mouse = { x: -1000, y: -1000, active: false, radius: 92 };
    let particles = [];
    let frameId = 0;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let darkTheme = document.documentElement.dataset.theme === "dark";

    function makeParticle(randomizePosition = true) {
      const speed = 0.7 + Math.random() * 1.45;
      const angle = (32 + Math.random() * 17) * Math.PI / 180;
      const vx = Math.cos(angle) * speed;
      const vy = Math.sin(angle) * speed;
      return {
        x: randomizePosition ? Math.random() * width : -30,
        y: randomizePosition ? Math.random() * height : -30,
        vx,
        vy,
        driftX: vx,
        driftY: vy,
        size: 0.55 + Math.random() * 1.25,
        alpha: 0.24 + Math.random() * 0.62,
        hue: 192 + Math.random() * 78,
        trail: 7 + Math.random() * 15,
      };
    }

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
      const desiredCount = reducedMotion.matches
        ? Math.max(56, Math.min(90, Math.round(width / 14)))
        : Math.max(176, Math.min(340, Math.round(width / 4)));
      particles = Array.from({ length: desiredCount }, () => makeParticle(true));
    }

    function respawnParticle(particle) {
      Object.assign(particle, makeParticle(false));

      // Alternate between the top and left edges so the lower-left quadrant
      // continuously receives new streaks instead of slowly becoming empty.
      if (Math.random() < 0.52) {
        particle.x = Math.random() * width;
        particle.y = -25 - Math.random() * 130;
      } else {
        particle.x = -25 - Math.random() * 130;
        particle.y = Math.random() * height;
      }
    }

    function cubicPoint(t, start, controlOne, controlTwo, end) {
      const inverse = 1 - t;
      return {
        x:
          inverse ** 3 * start.x +
          3 * inverse ** 2 * t * controlOne.x +
          3 * inverse * t ** 2 * controlTwo.x +
          t ** 3 * end.x,
        y:
          inverse ** 3 * start.y +
          3 * inverse ** 2 * t * controlOne.y +
          3 * inverse * t ** 2 * controlTwo.y +
          t ** 3 * end.y,
      };
    }

    function drawAnimatedComet(time, phase = 0, opacity = 1) {
      const cycle = ((time / 15500 + phase) % 1 + 1) % 1;
      if (cycle > 0.78) return;

      const t = cycle / 0.78;
      const eased = t * t * (3 - 2 * t);
      const start = { x: -width * 0.12, y: height * 0.05 };
      const controlOne = { x: width * 0.28, y: height * 0.01 };
      const controlTwo = { x: width * 0.72, y: height * 0.18 };
      const end = { x: width * 1.1, y: height * 0.52 };
      const head = cubicPoint(eased, start, controlOne, controlTwo, end);
      const tailT = Math.max(0, eased - 0.19);
      const tail = cubicPoint(tailT, start, controlOne, controlTwo, end);
      const fadeIn = Math.min(1, t * 7);
      const fadeOut = Math.min(1, (1 - t) * 5);
      const alpha = opacity * fadeIn * fadeOut;

      const trailGradient = context.createLinearGradient(tail.x, tail.y, head.x, head.y);
      trailGradient.addColorStop(0, "rgba(96, 116, 255, 0)");
      trailGradient.addColorStop(0.42, `rgba(114, 174, 255, ${0.18 * alpha})`);
      trailGradient.addColorStop(0.78, `rgba(155, 220, 255, ${0.62 * alpha})`);
      trailGradient.addColorStop(1, `rgba(255, 255, 255, ${0.98 * alpha})`);

      context.save();
      context.lineCap = "round";
      context.shadowColor = `rgba(104, 180, 255, ${0.9 * alpha})`;
      context.shadowBlur = 18;
      context.strokeStyle = trailGradient;
      context.lineWidth = 2.2;
      context.beginPath();
      const segments = 22;
      for (let index = 0; index <= segments; index += 1) {
        const segmentT = tailT + (eased - tailT) * (index / segments);
        const point = cubicPoint(segmentT, start, controlOne, controlTwo, end);
        if (index === 0) context.moveTo(point.x, point.y);
        else context.lineTo(point.x, point.y);
      }
      context.stroke();

      const headGlow = context.createRadialGradient(head.x, head.y, 0, head.x, head.y, 24);
      headGlow.addColorStop(0, `rgba(255, 255, 255, ${alpha})`);
      headGlow.addColorStop(0.2, `rgba(158, 224, 255, ${0.76 * alpha})`);
      headGlow.addColorStop(1, "rgba(92, 117, 255, 0)");
      context.fillStyle = headGlow;
      context.beginPath();
      context.arc(head.x, head.y, 24, 0, Math.PI * 2);
      context.fill();
      context.restore();
    }

    function bounceFromMouse(particle) {
      if (!mouse.active) return;
      let dx = particle.x - mouse.x;
      let dy = particle.y - mouse.y;
      let distance = Math.hypot(dx, dy);
      if (distance >= mouse.radius) return;

      if (distance < 0.01) {
        const angle = Math.random() * Math.PI * 2;
        dx = Math.cos(angle);
        dy = Math.sin(angle);
        distance = 1;
      }

      const nx = dx / distance;
      const ny = dy / distance;
      const inwardVelocity = particle.vx * nx + particle.vy * ny;

      if (inwardVelocity < 0) {
        particle.vx -= 2.08 * inwardVelocity * nx;
        particle.vy -= 2.08 * inwardVelocity * ny;
      }

      const displacement = mouse.radius - distance + 1.5;
      particle.x += nx * displacement;
      particle.y += ny * displacement;
      particle.vx += nx * 0.22;
      particle.vy += ny * 0.22;
    }

    function drawParticle(particle) {
      const tailX = particle.x - particle.vx * particle.trail;
      const tailY = particle.y - particle.vy * particle.trail;
      const gradient = context.createLinearGradient(tailX, tailY, particle.x, particle.y);
      gradient.addColorStop(0, `hsla(${particle.hue}, 92%, 73%, 0)`);
      gradient.addColorStop(1, `hsla(${particle.hue}, 96%, 83%, ${particle.alpha})`);
      context.beginPath();
      context.moveTo(tailX, tailY);
      context.lineTo(particle.x, particle.y);
      context.strokeStyle = gradient;
      context.lineWidth = particle.size;
      context.lineCap = "round";
      context.stroke();

      context.beginPath();
      context.arc(particle.x, particle.y, particle.size * 0.82, 0, Math.PI * 2);
      context.fillStyle = `hsla(${particle.hue}, 100%, 88%, ${Math.min(1, particle.alpha + 0.15)})`;
      context.fill();
    }

    function animate(time = 0) {
      frameId = window.requestAnimationFrame(animate);
      context.clearRect(0, 0, width, height);
      if (!darkTheme) return;

      if (!reducedMotion.matches) {
        drawAnimatedComet(time, 0, 1);
        drawAnimatedComet(time, 0.54, 0.42);
      }

      const motionScale = reducedMotion.matches ? 0.2 : 1;
      for (const particle of particles) {
        particle.x += particle.vx * motionScale;
        particle.y += particle.vy * motionScale;

        if (!reducedMotion.matches) bounceFromMouse(particle);

        particle.vx += (particle.driftX - particle.vx) * 0.004;
        particle.vy += (particle.driftY - particle.vy) * 0.004;

        if (particle.x > width + 45 || particle.y > height + 45 || particle.x < -220 || particle.y < -220) {
          respawnParticle(particle);
        }

        drawParticle(particle);
      }

      if (mouse.active && !reducedMotion.matches) {
        const glow = context.createRadialGradient(mouse.x, mouse.y, 4, mouse.x, mouse.y, mouse.radius);
        glow.addColorStop(0, "rgba(130, 211, 255, 0.045)");
        glow.addColorStop(0.74, "rgba(115, 168, 255, 0.018)");
        glow.addColorStop(1, "rgba(130, 190, 255, 0)");
        context.fillStyle = glow;
        context.beginPath();
        context.arc(mouse.x, mouse.y, mouse.radius, 0, Math.PI * 2);
        context.fill();
      }
    }

    function onPointerMove(event) {
      mouse.x = event.clientX;
      mouse.y = event.clientY;
      mouse.active = true;

      if (!reducedMotion.matches) {
        const normalizedX = event.clientX / Math.max(1, width) - 0.5;
        const normalizedY = event.clientY / Math.max(1, height) - 0.5;
        canvas.parentElement?.style.setProperty("--scene-x", `${normalizedX * -5.5}vw`);
        canvas.parentElement?.style.setProperty("--scene-y", `${normalizedY * -4.2}vh`);
      }
    }

    function onPointerLeave() {
      mouse.active = false;
      canvas.parentElement?.style.setProperty("--scene-x", "0px");
      canvas.parentElement?.style.setProperty("--scene-y", "0px");
    }

    const themeObserver = new MutationObserver(() => {
      darkTheme = document.documentElement.dataset.theme === "dark";
      if (!darkTheme) context.clearRect(0, 0, width, height);
    });

    resize();
    animate();
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    window.addEventListener("resize", resize);
    window.addEventListener("pointermove", onPointerMove, { passive: true });
    document.documentElement.addEventListener("pointerleave", onPointerLeave);

    window.__bloomfolioMeteorCleanup = () => {
      window.cancelAnimationFrame(frameId);
      themeObserver.disconnect();
      window.removeEventListener("resize", resize);
      window.removeEventListener("pointermove", onPointerMove);
      document.documentElement.removeEventListener("pointerleave", onPointerLeave);
      window.__bloomfolioMeteorCleanup = null;
    };
  }

  initMeteorParticles();
  document.addEventListener("astro:page-load", initMeteorParticles);
  document.addEventListener("astro:before-swap", () => {
    window.__bloomfolioMeteorCleanup?.();
  });
</script>
