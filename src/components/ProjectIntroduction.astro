---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const projectEntries = await getCollection("portfolioProjects");
const portfolioProjects = projectEntries
  .sort(
    (a, b) =>
      (a.data.sortOrder ?? 999) - (b.data.sortOrder ?? 999) ||
      a.data.title.localeCompare(b.data.title),
  )
  .slice(0, 3);
---

<section id="project-introduction" class="bg-base-300 px-4 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-4xl font-bold">Project Introduction</h2>
      <p class="text-lg text-base-content/70">
        Selected projects and ongoing work will be introduced here.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {portfolioProjects.map((project) => (
        <ProjectCard project={project} hrefBase="/portfolio-projects" />
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/portfolio-projects" class="btn btn-primary btn-outline">
        View All Projects
      </a>
    </div>
  </div>
</section>
