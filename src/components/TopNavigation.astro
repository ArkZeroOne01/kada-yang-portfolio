---
import ThemeToggle from "./ThemeToggle.astro";
import ThemeSelector from "./ThemeSelector.astro";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  enableThemeSelector?: boolean;
}

const { enableThemeSelector = true } = Astro.props;

const homePrefix = Astro.url.pathname === "/" ? "" : "/";
const navItems = [
  { href: `${homePrefix}#home`, label: "Home" },
  { href: `${homePrefix}#latest-articles`, label: "Latest Articles" },
  { href: `${homePrefix}#project-introduction`, label: "Project Introduction" },
  { href: `${homePrefix}#education`, label: "Education" },
  { href: `${homePrefix}#competition-awards`, label: "Competition Awards" },
  { href: `${homePrefix}#honors`, label: "Honors" },
  { href: `${homePrefix}#contact`, label: "Contact Me" },
];
---

<div class="pointer-events-none fixed inset-x-0 top-3 z-[70] flex justify-center px-2 sm:top-4">
  <nav
    class="portfolio-island pointer-events-auto flex max-w-[calc(100vw-1rem)] items-center gap-1 rounded-full border px-2 py-1.5 shadow-2xl backdrop-blur-2xl backdrop-saturate-150"
    aria-label="Main navigation"
  >
    <div class="island-links flex min-w-0 items-center gap-0.5 overflow-x-auto scroll-smooth">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="island-link shrink-0 rounded-full px-3 py-2 text-xs font-semibold transition-all duration-200 sm:text-sm"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="island-divider mx-1 h-7 w-px shrink-0" aria-hidden="true"></div>

    <div class="island-controls flex shrink-0 items-center gap-0.5">
      <LanguageToggle />
      {enableThemeSelector ? <ThemeSelector /> : <ThemeToggle />}
    </div>
  </nav>
</div>

<style>
  .portfolio-island {
    --island-text: var(--color-base-content);
    --island-surface: color-mix(in oklab, var(--color-base-100) 76%, transparent);
    --island-border: color-mix(in oklab, var(--color-base-content) 16%, transparent);
    --island-hover: color-mix(in oklab, var(--color-base-content) 10%, transparent);
    --island-active: color-mix(in oklab, var(--color-base-content) 15%, transparent);
    background: var(--island-surface);
    border-color: var(--island-border);
    color: var(--island-text);
    font-family: inherit;
    box-shadow: 0 18px 55px color-mix(in oklab, var(--color-base-content) 20%, transparent);
  }

  :global(html[data-theme="dark"]) .portfolio-island {
    --island-text: #f8fafc;
    --island-surface: rgb(0 0 0 / 0.72);
    --island-border: rgb(255 255 255 / 0.16);
    --island-hover: rgb(255 255 255 / 0.11);
    --island-active: rgb(255 255 255 / 0.18);
    box-shadow: 0 18px 60px rgb(0 0 0 / 0.42);
  }

  :global(html[data-theme="bloom"]) .portfolio-island {
    --island-text: #6f3f20;
    --island-surface: rgb(255 246 213 / 0.76);
    --island-border: rgb(111 63 32 / 0.2);
    --island-hover: rgb(111 63 32 / 0.09);
    --island-active: rgb(111 63 32 / 0.15);
    box-shadow: 0 16px 50px rgb(113 73 30 / 0.2);
  }

  .island-links {
    scrollbar-width: none;
  }

  .island-links::-webkit-scrollbar {
    display: none;
  }

  .island-link {
    color: var(--island-text);
    font-family: inherit;
    opacity: 0.72;
  }

  .island-link:hover {
    background: var(--island-hover);
    opacity: 1;
  }

  .island-link[aria-current="page"] {
    background: var(--island-active);
    color: var(--island-text);
    opacity: 1;
    box-shadow: inset 0 0 0 1px var(--island-border);
  }

  .island-divider {
    background: var(--island-border);
  }

  :global(.portfolio-island #language-toggle),
  :global(.portfolio-island .island-controls [role="button"]) {
    min-height: 2rem;
    height: 2rem;
    border-color: transparent;
    background: transparent;
    color: var(--island-text);
    box-shadow: none;
    font-family: inherit;
  }

  :global(.portfolio-island #language-toggle:hover),
  :global(.portfolio-island .island-controls [role="button"]:hover) {
    background: var(--island-hover);
  }

  :global(.portfolio-island .dropdown-content) {
    margin-top: 0.8rem;
    border: 1px solid var(--island-border);
    background: color-mix(in oklab, var(--color-base-100) 92%, transparent);
    color: var(--color-base-content);
    font-family: inherit;
    backdrop-filter: blur(20px);
  }
</style>

<script>
  function setupIslandNavigation() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".island-link"));
    const sections = links
      .map((link) => document.querySelector<HTMLElement>(link.getAttribute("href") || ""))
      .filter((section): section is HTMLElement => Boolean(section));

    if (!links.length || !sections.length) return;

    window.__bloomfolioIslandObserver?.disconnect();
    const setActive = (id: string) => {
      let activeLink: HTMLAnchorElement | undefined;
      links.forEach((link) => {
        const active = link.getAttribute("href") === `#${id}`;
        if (active) {
          link.setAttribute("aria-current", "page");
          activeLink = link;
        }
        else link.removeAttribute("aria-current");
      });
      activeLink?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target.id) setActive(visible.target.id);
      },
      { rootMargin: "-18% 0px -62% 0px", threshold: [0, 0.1, 0.35] },
    );

    sections.forEach((section) => observer.observe(section));
    window.__bloomfolioIslandObserver = observer;
    setActive(location.hash.slice(1) || "home");
  }

  setupIslandNavigation();
  document.addEventListener("astro:page-load", setupIslandNavigation);
</script>
