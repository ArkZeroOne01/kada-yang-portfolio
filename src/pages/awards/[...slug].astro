---
import { getCollection, type CollectionEntry } from "astro:content";
import AwardLayout from "../../layouts/AwardLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("hackathons");

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"hackathons">;
}

const { entry } = Astro.props;
---

<AwardLayout
  title={entry.data.title}
  titleZh={entry.data.titleZh}
  award={entry.data.award}
  awardZh={entry.data.awardZh}
  tier={entry.data.tier}
  startDate={entry.data.startDate}
  certificate={entry.data.certificate}
  rotateCertificate={entry.data.rotateCertificate}
  description={entry.data.description}
  descriptionZh={entry.data.descriptionZh}
/>
