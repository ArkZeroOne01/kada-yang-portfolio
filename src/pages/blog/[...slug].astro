---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { resolveContentSidebar } from "../../utils/contentSidebar";

export async function getStaticPaths() {
  const entries = (await getCollection("blog")).filter(
    (entry) => entry.data.published
  );

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const generalEntry = await getEntry("general", "index");
const contentSidebar = resolveContentSidebar(
  generalEntry?.data,
  entry.data.contentSidebar
);
---

<BlogLayout
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  image={entry.data.image}
  tags={entry.data.tags}
  headings={headings}
  contentSidebar={contentSidebar}
>
  <Content />
</BlogLayout>
