---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Timeline from "../components/Timeline.astro";
import Projects from "../components/Projects.astro";
import ProjectIntroduction from "../components/ProjectIntroduction.astro";
import Hackathons from "../components/Hackathons.astro";
import HonorsPlaceholder from "../components/HonorsPlaceholder.astro";
import Contact from "../components/Contact.astro";
import { GraduationCap } from "@lucide/astro";
import { getEntry, render } from "astro:content";

// Load Hero singleton
const heroEntry = await getEntry("hero", "index");
if (!heroEntry) {
  throw new Error('Missing required content entry: "hero/index"');
}

// Load About singleton
const aboutEntry = await getEntry("about", "index");
if (!aboutEntry) {
  throw new Error('Missing required content entry: "about/index"');
}

const { Content: AboutContent } = await render(aboutEntry);

// Load General singleton
const generalEntry = await getEntry("general", "index");
if (!generalEntry) {
  throw new Error('Missing required content entry: "general/index"');
}

const general = generalEntry.data;
---

<Layout
  title={`${heroEntry.data.name} - Portfolio`}
  description={heroEntry.data.description}
>
  <main>
    <!-- Hero Section (Always visible) -->
    <Hero hero={heroEntry.data} />

    <!-- Keep the complete portfolio available on every screen size -->
    <div class="block">
      <!-- About Section -->
      {
        general.showAboutSection && (
          <About
            title={aboutEntry.data.title}
            photo={aboutEntry.data.photo}
            Content={AboutContent}
            link={aboutEntry.data.link}
          />
        )
      }

      <!-- Latest Articles Section -->
      {general.showProjectsSection && <Projects />}

      <!-- Project Introduction Section -->
      {general.showBlogSection && <ProjectIntroduction />}

      <!-- Education Section -->
      {
        general.showEducationSection && (
          <Timeline
            collection="education"
            variant="list"
            color="secondary"
            backgroundColor="base-200"
            icon={GraduationCap}
            sectionTitle="Education"
          />
        )
      }

      <!-- Competition Awards Section -->
      {general.showHackathonsSection && <Hackathons />}

      <!-- Honors placeholder -->
      <HonorsPlaceholder />

      <!-- Contact Section -->
      {general.showContactSection && <Contact />}
    </div>
  </main>
</Layout>
