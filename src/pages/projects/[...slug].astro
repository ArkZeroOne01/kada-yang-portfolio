---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import { resolveContentSidebar } from "../../utils/contentSidebar";

export async function getStaticPaths() {
  const entries = await getCollection("projects");

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const generalEntry = await getEntry("general", "index");
const contentSidebar = resolveContentSidebar(
  generalEntry?.data,
  entry.data.contentSidebar
);
---

<ProjectLayout
  title={entry.data.title}
  description={entry.data.description}
  startDate={entry.data.startDate}
  endDate={entry.data.endDate}
  image={entry.data.image}
  skills={entry.data.skills}
  demoLink={entry.data.demoLink}
  sourceLink={entry.data.sourceLink}
  headings={headings}
  contentSidebar={contentSidebar}
>
  <Content />
</ProjectLayout>
